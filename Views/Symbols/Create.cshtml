@using TradingProject.Resources
@model TradingProject.Models.TradingSymbol
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Model?.Id > 0 ? Resources.EditSymbol : Resources.AddNewSymbol;
    var isEdit = Model?.Id > 0;
}

<h4 class="mb-3">@(isEdit ? Resources.EditSymbol : Resources.AddNewSymbol)</h4>

<div class="tj-card">
    <div class="tj-card-body">
        <form asp-action="@(isEdit ? "Edit" : "Create")" method="post" asp-antiforgery="true" novalidate>
            @Html.AntiForgeryToken()
            @if (isEdit) { <input type="hidden" asp-for="Id" /> }
            <div asp-validation-summary="All" class="text-danger small mb-3"></div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">@Resources.Symbol</label>
                    <input asp-for="Symbol" class="form-control" required />
                    <span asp-validation-for="Symbol" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label">@Resources.Name</label>
                    <input asp-for="Name" class="form-control" />
                </div> 
                <div class="col-md-4">
                    <label class="form-label">@Resources.NameFa</label>
                    <input asp-for="NameFa" class="form-control" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">@Resources.InstrumentType</label>
                    <select asp-for="InstrumentType" class="form-select">
                        @foreach (var it in ViewBag.InstrumentTypes)
                        {
                            <option value="@((int)it)" selected="@(Model?.InstrumentType == it)">@it</option>
                        }
                    </select>
                </div>
                <div class="col-md-12">
                    <div class="form-check">
                        <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                        <label asp-for="IsActive" class="form-check-label">@Resources.IsActive</label>
                    </div>
                </div>
            </div>
            <div class="mt-3">
                <button type="submit" class="btn tj-btn-primary">@(isEdit ? Resources.Update : Resources.Save)</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary">@Resources.Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
