@using TradingProject.Resources
@model IEnumerable<TradingProject.Models.TradingSymbol>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Resources.Symbols;
}

<div class="tj-page-head">
    <div>
        <p class="tj-kicker">@Resources.LookupData</p>
        <h1>@Resources.Symbols</h1>
    </div>
    <a href="@Url.Action("Create")" class="btn tj-btn-primary">@Resources.AddNewSymbol</a>
</div>
<partial name="_Alerts" />

<div class="tj-card">
    <div class="tj-card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>@Resources.ID</th>
                        <th>@Resources.Symbol</th>
                        <th>@Resources.Name</th>
                        <th>@Resources.NameFa</th>
                        <th>@Resources.InstrumentType</th>
                        <th>@Resources.IsActive</th>
                        <th>@Resources.Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>@s.Id</td>
                            <td>@s.Symbol</td>
                            <td>@s.Name</td>
                            <td>@s.NameFa</td>
                            <td>@s.InstrumentType</td>
                            <td>
                                <span class="tj-pill @(s.IsActive ? "is-on" : "is-off")">@(s.IsActive ? "✓" : "✗")</span>
                            </td>
                            <td class="tj-row-actions">
                                <a href="@Url.Action("Edit", new { id = s.Id })" class="btn btn-sm btn-outline-primary">@Resources.Edit</a>
                                <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('@Resources.ConfirmDelete')">
                                    <button class="btn btn-sm btn-outline-danger">@Resources.Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
